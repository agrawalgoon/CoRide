PORT=5000
NODE_ENV=development
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/coride"
CLIENT_URL="http://localhost:5173"
JWT_SECRET="replace_with_a_secure_secret"
JWT_EXPIRES_IN="7d"

# Email Provider Configuration
# Options: "console" (mock logging in dev), "resend" (free 3,000 emails/month API), or "smtp" (Gmail, Brevo, Mailtrap, etc.)
EMAIL_PROVIDER="console"
EMAIL_FROM="CoRide <onboarding@resend.dev>"

# Resend API Configuration (when EMAIL_PROVIDER=resend)
# Sign up at https://resend.com (free tier provides 3,000 emails/mo, 100/day)
RESEND_API_KEY="re_placeholder_api_key"

# SMTP Configuration (when EMAIL_PROVIDER=smtp)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="smtp_user"
SMTP_PASS="smtp_password"
