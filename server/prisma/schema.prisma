// Prisma Schema for CoRide (Enterprise & Campus Carpooling Platform)
// Database: MySQL 8.0+

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  USER
  ADMIN
}

enum OrgType {
  COLLEGE
  CORPORATE
  TECH_PARK
}

enum OrgRole {
  STUDENT
  FACULTY
  STAFF
  EMPLOYEE
}

enum VerificationStatus {
  PENDING_EMAIL
  EMAIL_VERIFIED
  DOCS_SUBMITTED
  FULLY_VERIFIED
  REJECTED
}

enum VehicleType {
  SEDAN
  HATCHBACK
  SUV
  EV
  MOTORBIKE
}

enum RideStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED_PASSENGER
  CANCELLED_DRIVER
  BOARDED
  COMPLETED
}

enum AttendanceMethod {
  DYNAMIC_QR
  MANUAL_OTP
  DRIVER_OVERRIDE
}

enum NotificationType {
  RIDE_REQUEST_RECEIVED
  REQUEST_ACCEPTED
  REQUEST_REJECTED
  RIDE_DEPARTURE_REMINDER
  AI_MATCH_FOUND
  ATTENDANCE_SUCCESS
  RIDE_CANCELLED
}

// ========================================================
// 1. ORGANIZATION (Institutions, Campuses & Tech Parks)
// ========================================================

model Organization {
  id                   String   @id @default(uuid())
  name                 String   @unique @db.VarChar(255)
  orgType              OrgType  @default(COLLEGE)
  domainList           Json     // Array of allowed domains, e.g. ["stanford.edu"]
  campusHubName        String   @db.VarChar(255)
  campusAddress        String   @db.VarChar(500)
  campusLatitude       Float
  campusLongitude      Float
  geofenceRadiusMeters Int      @default(200)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users User[]

  @@map("organizations")
}

// ========================================================
// 2. USER (Students, Faculty, Corporate Employees)
// ========================================================

model User {
  id                 String             @id @default(uuid())
  organizationId     String?
  name               String             @db.VarChar(150)
  email              String             @unique @db.VarChar(255)
  passwordHash       String             @db.VarChar(255)
  phone              String?            @db.VarChar(20)
  role               Role               @default(USER)
  isVerified         Boolean            @default(false)
  avatarUrl          String?            @db.VarChar(500)
  orgEmail           String?            @db.VarChar(255)
  orgRole            OrgRole            @default(STUDENT)
  orgIdBadgeUrl      String?            @db.VarChar(500)
  isOrgVerified      Boolean            @default(false)
  dlNumber           String?            @db.VarChar(50)
  dlPhotoUrl         String?            @db.VarChar(500)
  isDlVerified       Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING_EMAIL)

  driverRatingAvg      Float @default(5.00)
  driverRatingCount    Int   @default(0)
  passengerRatingAvg   Float @default(5.00)
  passengerRatingCount Int   @default(0)
  co2SavedKgTotal      Float @default(0.00)

  preferences      Json? // E.g. { "genderPreference": "ANY", "music": true, "quiet": false, "ac": true }
  emergencyContact Json? // E.g. { "name": "Jane Liu", "phone": "...", "relationship": "Parent" }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization           Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  vehicles               Vehicle[]
    emailVerificationOtps EmailVerificationOtp[]
  ridesDriven            Ride[]         @relation("DriverRides")
  bookings               Booking[]      @relation("PassengerBookings")
  notificationsReceived  Notification[] @relation("RecipientNotifications")
  notificationsSent      Notification[] @relation("SenderNotifications")

  @@index([organizationId])
  @@index([email])
  @@index([verificationStatus])
  @@map("users")
}
// ========================================================
// EMAIL VERIFICATION OTP
// ========================================================

model EmailVerificationOtp {
  id         String   @id @default(uuid())
  userId     String
  otpHash    String   @db.VarChar(255)
  expiresAt  DateTime
  attempts   Int      @default(0)
  verifiedAt DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_otps")
}

// ========================================================
// 3. VEHICLE (Passenger Vehicles)
// ========================================================

model Vehicle {
  id                  String      @id @default(uuid())
  userId              String
  make                String      @db.VarChar(100)
  model               String      @db.VarChar(100)
  year                Int
  color               String      @db.VarChar(50)
  plateNumber         String      @unique @db.VarChar(30)
  seatCapacity        Int
  vehicleType         VehicleType @default(SEDAN)
  rcPhotoUrl          String?     @db.VarChar(500)
  insuranceValidUntil DateTime?   @db.Date
  isVerified          Boolean     @default(false)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // Relations
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  rides Ride[]

  @@index([userId])
  @@index([plateNumber])
  @@map("vehicles")
}

// ========================================================
// 4. RIDE (Carpool Commute Offers with Geolocation)
// ========================================================

model Ride {
  id                   String     @id @default(uuid())
  driverId             String
  vehicleId            String
  originAddress        String     @db.VarChar(500)
  originLandmark       String?    @db.VarChar(255)
  originLatitude       Float
  originLongitude      Float
  destinationAddress   String     @db.VarChar(500)
  destinationLandmark  String?    @db.VarChar(255)
  destinationLatitude  Float
  destinationLongitude Float
  departureTime        DateTime
  totalSeats           Int
  availableSeats       Int
  pricePerSeat         Float      @default(0.00)
  isRecurring          Boolean    @default(false)
  recurringDays        Json?      // E.g. ["MON", "TUE", "WED", "THU", "FRI"]
  ladiesOnly           Boolean    @default(false)
  luggageAllowed       Boolean    @default(true)
  status               RideStatus @default(SCHEDULED)
  geofenceRadiusMeters Int        @default(150)
  activeTotpSecret     String?    @db.VarChar(64)
  co2SavedEstimateKg   Float      @default(3.20)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  // Relations
  driver         User            @relation("DriverRides", fields: [driverId], references: [id], onDelete: Restrict)
  vehicle        Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  bookings       Booking[]
  attendanceLogs AttendanceLog[]

  @@index([driverId])
  @@index([vehicleId])
  @@index([departureTime, status, availableSeats])
  @@index([originLatitude, originLongitude])
  @@index([destinationLatitude, destinationLongitude])
  @@map("rides")
}

// ========================================================
// 5. BOOKING (Ride Requests & Seat Reservations)
// ========================================================

model Booking {
  id                      String            @id @default(uuid())
  rideId                  String
  passengerId             String
  seatsBooked             Int               @default(1)
  fareContributionTotal   Float
  pickupAddress           String            @db.VarChar(500)
  pickupLatitude          Float
  pickupLongitude         Float
  dropAddress             String            @db.VarChar(500)
  dropLatitude            Float
  dropLongitude           Float
  status                  BookingStatus     @default(PENDING)
  isAttended              Boolean           @default(false)
  attendedAt              DateTime?
  attendanceMethod        AttendanceMethod?
  attendanceDistanceMeters Float?
  cancellationReason      String?           @db.VarChar(255)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  // Relations
  ride           Ride            @relation(fields: [rideId], references: [id], onDelete: Cascade)
  passenger      User            @relation("PassengerBookings", fields: [passengerId], references: [id], onDelete: Restrict)
  attendanceLogs AttendanceLog[]

  @@unique([rideId, passengerId])
  @@index([rideId])
  @@index([passengerId])
  @@index([status])
  @@map("bookings")
}

// ========================================================
// 6. ATTENDANCE_LOG (Dynamic QR & Geofence Audit Trail)
// ========================================================

model AttendanceLog {
  id                     String   @id @default(uuid())
  bookingId              String
  rideId                 String
  driverLatitude         Float
  driverLongitude        Float
  distanceToPickupMeters Float
  isGeofenceValid        Boolean
  qrTokenHash            String   @db.VarChar(128)
  verifiedAt             DateTime @default(now())

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ride    Ride    @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([rideId])
  @@map("attendance_logs")
}

// ========================================================
// 7. NOTIFICATION (Alerts & Communications)
// ========================================================

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  senderId    String?
  type        NotificationType
  title       String           @db.VarChar(255)
  message     String           @db.Text
  metadata    Json?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  // Relations
  recipient User  @relation("RecipientNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  sender    User? @relation("SenderNotifications", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([recipientId, isRead, createdAt])
  @@index([recipientId])
  @@map("notifications")
}
